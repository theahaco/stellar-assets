# The environment to use `development`, `testing`, `staging`, `production`
STELLAR_SCAFFOLD_ENV=development

# Location of the config files for this project for the scaffold stellar CLI.
# Learn more at https://developers.stellar.org/docs/tools/cli/stellar-cli#stellar-config-dir
XDG_CONFIG_HOME=".config"

# Prefix with "PUBLIC_" to make available in frontend files
# Which Stellar network to use in the frontend: local, testnet, futurenet, or mainnet
# More on Stellar networks: https://developers.stellar.org/docs/networks

PUBLIC_STELLAR_NETWORK="LOCAL"
# The Stellar network passphrase, this is local
PUBLIC_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# The Stellar network RPC URL. this is local
PUBLIC_STELLAR_RPC_URL="http://localhost:8000/rpc"

# PUBLIC_STELLAR_NETWORK="TESTNET"
# PUBLIC_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# PUBLIC_STELLAR_RPC_URL="https://soroban-testnet.stellar.org"

# PUBLIC_STELLAR_NETWORK="MAINNET"
# PUBLIC_STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"
# PUBLIC_STELLAR_RPC_URL="https://soroban-rpc.mainnet.stellar.gateway.fm"

# Authline onboard router id; defaults to the SDK's pinned ROUTERS entry for the network.
# PUBLIC_ROUTER=

# Live asset the dApp activates. Defaults are network-aware: mainnet -> EURCV,
# every other network -> the pinned testnet USDC (open). For a fully-pinned asset
# only the code is needed; issuer/SAC/authorizer/capability come from the SDK
# registry. To exercise the regulated / one-step-authorize path on testnet
# (EURCV-style: AUTH_REQUIRED + a one-step authorizer), point it at the pinned
# test token TLO:
# PUBLIC_ASSET_CODE=TLO


# Authline relayer the reference withdrawal screen (withdraw.html) uses as its
# exchange backend for the SEP-7 handoff (docs/sep7-handoff.md). Defaults to
# the hosted testnet instance; "none" disables the screen.
# PUBLIC_RELAYER_URL=http://127.0.0.1:8787


# ── Sponsorship (operations account) ────────────────────────────────────────
# The ops account pays the CAP-33 trustline reserve and the CAP-15 fee bump so
# a holder with no XLM can still onboard. Its PUBLIC key is shipped to the
# browser; the SECRET is only ever read by the sponsor service.

# The ops account's public key — safe to expose, the frontend needs it to build
# the sponsored transaction.
# PUBLIC_SPONSOR=

# Sponsor service endpoint the app POSTs the holder-signed XDR to.
# PUBLIC_SPONSOR_URL=

# The ops account's SECRET key — service-side only.
#
#   * NEVER prefix it with PUBLIC_ — vite's envPrefix is "PUBLIC_", so that
#     would compile the secret into the browser bundle.
#   * NEVER put it in .env.testnet / .env.e2e* / .env.example — those are
#     TRACKED IN GIT. Only bare `.env` (and other `.env.*` names) are ignored.
#   * Use a key generated for this purpose alone, with no mainnet history.
#
# Put the real value in `.env`, which is gitignored:
#   SPONSOR_SECRET=S...
